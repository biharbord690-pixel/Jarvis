rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'biharbord690@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admins role collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /adminUsers/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users: only the user can read/write their own profile; admin can read
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders: authenticated user can read their own order matching UID or email; admin can read/write
    match /orders/{orderId} {
      allow get: if isAdmin() || (isAuthenticated() && (resource.data.customerEmail == request.auth.token.email || resource.data.userId == request.auth.uid));
      allow list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if true; // Allows order creation from client checkout flow
      allow update, delete: if isAdmin();
    }

    // Software Licenses: authenticated owner or admin
    match /licenses/{licenseKey} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.customerEmail == request.auth.token.email || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Public products read-only; admin write
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public release metadata (non-disabled); admin write
    match /releases/{releaseId} {
      allow read: if resource.data.isActive == true && resource.data.isEmergencyDisabled == false || isAdmin();
      allow write: if isAdmin();
    }

    // Public App Settings
    match /appSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Download Entitlements
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated() && (resource.data.customerEmail == request.auth.token.email || resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Support tickets
    match /supportTickets/{ticketId} {
      allow create: if true;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerEmail == request.auth.token.email);
      allow update, delete: if isAdmin();
    }
  }
}
